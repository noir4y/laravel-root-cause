APP_NAME="Laravel Root Cause Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

ROOT_CAUSE_ENABLED=true
ROOT_CAUSE_DRIVER=file
ROOT_CAUSE_STORAGE_PATH=storage/app/root-cause
ROOT_CAUSE_RETENTION_DAYS=7
